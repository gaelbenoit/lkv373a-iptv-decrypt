# Normalize line endings in the repo (store as LF), check out native.
* text=auto eol=lf

# Source and docs are text (LF).
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.gitattributes text eol=lf
*.gitignore     text eol=lf

# Safety: never normalize these if ever added.
*.png  binary
*.jpg  binary
*.mp4  binary
*.ts   binary
*.bin  binary
*.pkg  binary
*.rom  binary
*.pcapng binary
